{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"nm000305","name":"NETBCI2026: NETBCI: longitudinal right-hand motor imagery vs rest BCI training","description":"A longitudinal EEG dataset of 19 healthy right-handed participants trained over four sessions on separate days to control a brain-computer interface. Participants used sustained right-hand grasping motor imagery versus rest to move a cursor on a one-dimensional two-target task with online visual feedback. Each session comprised six feedback runs, giving 14,431 trials in total. The recordings were made with a 74-channel EEG system alongside MEG and are organized in BIDS format.","source":"nemar","recording_modality":["EEG"],"bids_version":null,"license":"CC-BY-4.0","authors":[{"name":"Marie-Constance Corsi","name_type":"Personal","orcid":"0000-0002-6262-5036"},{"name":"Christophe Gitton","name_type":"Personal"},{"name":"Juliana Gonzalez-Astudillo","name_type":"Personal"},{"name":"Ari E. Kahn","name_type":"Personal"},{"name":"Laurent Hugueville","name_type":"Personal"},{"name":"Denis Schwartz","name_type":"Personal","orcid":"0000-0002-8557-2934"},{"name":"Nathalie George","name_type":"Personal"},{"name":"Mario Chavez","name_type":"Personal"},{"name":"Sophie Dupont","name_type":"Personal"},{"name":"Danielle S. Bassett","name_type":"Personal","orcid":"0000-0002-6183-4493"},{"name":"Fabrizio De Vico Fallani","name_type":"Personal"}],"anonymous":false,"keywords":[{"term":"EEG"},{"term":"Brain-Computer Interfaces","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D062207"},{"term":"Motor Imagery"},{"term":"Neurofeedback","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D058765"},{"term":"longitudinal training"},{"term":"MEG"}],"related_identifiers":[{"identifier":"10.1038/s41597-026-08237-5","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"10.57745/RBJRC7","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"https://github.com/nemar