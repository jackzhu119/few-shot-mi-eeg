{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"nm000267","name":"Shin et al. 2017 (Experiment A) — Open Access Dataset for EEG+NIRS Single-Trial Classification","description":"An open access dataset for hybrid brain-computer interface research combining EEG and near-infrared spectroscopy (NIRS). This portion (Experiment A) contains recordings from 29 healthy participants performing left versus right hand kinesthetic motor imagery over multiple sessions. The data include 30 EEG channels plus EOG, are preprocessed, and are annotated with HED tags. They support single-trial classification and multimodal BCI validation.","source":"nemar","recording_modality":["EEG"],"bids_version":null,"license":"GPL-3.0","authors":[{"name":"Jaeyoung Shin","name_type":"Personal"},{"name":"Alexander von Lühmann","name_type":"Personal"},{"name":"Benjamin Blankertz","name_type":"Personal"},{"name":"Do-Won Kim","name_type":"Personal"},{"name":"Jichai Jeong","name_type":"Personal"},{"name":"Han-Jeong Hwang","name_type":"Personal"},{"name":"Klaus-Robert Müller","name_type":"Personal"}],"anonymous":false,"keywords":[{"term":"EEG"},{"term":"near-infrared spectroscopy"},{"term":"brain-computer interface"},{"term":"motor imagery"},{"term":"hybrid BCI"},{"term":"mental arithmetic"}],"related_identifiers":[{"identifier":"10.1109/TNSRE.2016.2628057","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"https://github.com/nemarDatasets/nm000267","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"https://nemar.org/dataset/nm000267","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"10.21105/joss.01896","identifier_type":"DOI","relation_type":"References"},{"identifier":"10.1038/s41597-019-0104-8","identifier_type":"DOI","relation_type":"References"}],"data_papers":[{"doi":"10.1109/tnsre.2016.2628057","title":"Open Access Dataset for EEG+NIRS Single-Trial Classification","year":2016,"venue":"IEEE Transactions on Neural Systems an