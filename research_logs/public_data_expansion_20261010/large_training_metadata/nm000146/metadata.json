{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"nm000146","name":"Motor Imagery dataset from Weibo et al 2014","description":"A 60-channel EEG dataset from 10 healthy, BCI-naive participants performing simple limb motor imagery (left hand, right hand, feet) and compound limb motor imagery (both hands, left hand with right foot, right hand with left foot), plus a rest condition. The recordings were used to examine EEG oscillatory patterns (ERD/ERS), cognitive processes, and effective connectivity during motor imagery. This is a preprocessed (bandpass filtered, downsampled to 200 Hz) BIDS version curated through MOABB.","source":"nemar","recording_modality":["EEG"],"bids_version":null,"license":"CC0-1.0","authors":[{"name":"Weibo Yi","name_type":"Personal"},{"name":"Shuang Qiu","name_type":"Personal"},{"name":"Kun Wang","name_type":"Personal"},{"name":"Hongzhi Qi","name_type":"Personal"},{"name":"Lixin Zhang","name_type":"Personal"},{"name":"Peng Zhou","name_type":"Personal"},{"name":"Feng He","name_type":"Personal"},{"name":"Dong Ming","name_type":"Personal"}],"anonymous":false,"keywords":[{"term":"EEG"},{"term":"motor imagery"},{"term":"compound limb motor imagery"},{"term":"event-related desynchronization"},{"term":"effective connectivity"},{"term":"brain-computer interface"}],"related_identifiers":[{"identifier":"10.1371/journal.pone.0114853","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"10.7910/DVN/27306","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"https://github.com/nemarDatasets/nm000146","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"https://nemar.org/dataset/nm000146","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"10.21105/joss.01896","identifier_type":"DOI","relation_type":"References"},{"identifier":"10.1038/s41597-019-0104-8","identifier_type":"DOI","relation_type":"References"}],"data_papers":[{"doi":"10.1371/journal.pone.0114853","title":"