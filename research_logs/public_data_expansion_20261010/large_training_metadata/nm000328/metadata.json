{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"nm000328","name":"MILimbEEG: Motor and motor-imagery limb EEG dataset (MILimbEEG)","description":"MILimbEEG is an EEG dataset from 60 volunteers performing and imagining upper- and lower-limb movements (hand closing and dorsal/plantar foot flexion, left and right), plus baseline eyes-open and rest conditions. It comprises over 8,680 four-second recordings acquired with a 16-channel dry-electrode OpenBCI Cyton+Daisy system at 125 Hz. The cohort includes healthy participants and some clinical cases, such as amputees and post-COVID-19 participants. The dataset supports brain-computer interface research on motor execution and motor imagery.","source":"nemar","recording_modality":["EEG"],"bids_version":null,"license":"CC-BY-4.0","authors":[{"name":"Victor Asanza","name_type":"Personal","orcid":"0000-0002-2786-4162"},{"name":"Daniel Montoya","name_type":"Personal","orcid":"0000-0001-5431-9701"},{"name":"Leandro L. Lorente-Leyva","name_type":"Personal","orcid":"0000-0002-2973-7765"},{"name":"Diego H. Peluffo-Ordonez","name_type":"Personal"},{"name":"Kleber Gonzalez","name_type":"Personal"}],"anonymous":false,"keywords":[{"term":"EEG"},{"term":"motor imagery"},{"term":"motor execution"},{"term":"brain-computer interface"},{"term":"upper limb"},{"term":"lower limb"},{"term":"OpenBCI"},{"term":"Electroencephalography","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D004569"}],"related_identifiers":[{"identifier":"10.1016/j.dib.2023.109540","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"10.17632/x8psbz3f6x.2","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"https://github.com/nemarDatasets/nm000328","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"https://nemar.org/dataset/nm000328","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"10.21105/joss.01896","identifier_type":"DOI","relation_type":"References"},{"id