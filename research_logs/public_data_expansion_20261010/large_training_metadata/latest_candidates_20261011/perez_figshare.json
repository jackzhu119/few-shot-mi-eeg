p", "size": 38073515, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/62570959", "supplied_md5": "9784ce75588e64e7f4628e89d7d92a76", "computed_md5": "9784ce75588e64e7f4628e89d7d92a76", "mimetype": "application/zip"}, {"id": 62570998, "name": "sub-41.zip", "size": 38005702, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/62570998", "supplied_md5": "fad1c5b7e120222529309b33ea960332", "computed_md5": "fad1c5b7e120222529309b33ea960332", "mimetype": "application/zip"}, {"id": 62571001, "name": "sub-42.zip", "size": 40151184, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/62571001", "supplied_md5": "47823856dbc8fa0e6e8419ab77f09e49", "computed_md5": "47823856dbc8fa0e6e8419ab77f09e49", "mimetype": "application/zip"}, {"id": 62571004, "name": "sub-43.zip", "size": 36792420, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/62571004", "supplied_md5": "95eb79cc66cf3f2b5bb83603daa703fc", "computed_md5": "95eb79cc66cf3f2b5bb83603daa703fc", "mimetype": "application/zip"}, {"id": 62571007, "name": "sub-44.zip", "size": 40077233, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/62571007", "supplied_md5": "899580305df6108f344b4de2caab65b6", "computed_md5": "899580305df6108f344b4de2caab65b6", "mimetype": "application/zip"}, {"id": 62571010, "name": "sub-45.zip", "size": 40196939, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/62571010", "supplied_md5": "2b244df97f458f66f7337695beb85fd4", "computed_md5": "2b244df97f458f66f7337695beb85fd4", "mimetype": "application/zip"}], "folder_structure": {}, "authors": [{"id": 21377744, "full_name": "Jorge German Perez Blanco", "first_name": "Jorge German", "last_name": "Perez Blanco", "is_active": true, "url_name": "Jorge_German_Perez_Blanco", "orcid_id": "0000-0002-3631-4269"}, {"id": 21688979, "full_name": "Javier Mauricio Anteliz Ortiz", "first_name": "Javier Mauricio", "last_name": "Anteliz Ortiz", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-3377-0813"}], "custom_fields": [], "figshare_url": "https://figshare.com/articles/dataset/EEG-EMG-WristMotion_Dataset/29666735", "download_disabled": false, "description": "<pre>The goal of this experiment is to identify potential biomarkers in EEG and EMG signals that, combined with wrist kinematic data, enable an objective assessment of motor performance during wrist-related tasks.<br><br>To achieve this, we used the Biomech Wrist\u2014a 3-degree-of-freedom wrist rehabilitation exoskeleton designed to support Flexion-Extension, Ulnar-Radial Deviation, and Pronation-Supination movements. The device is integrated with a virtual interface that allows users to control an on-screen cursor.<br><br>During the task, visual targets appear at various positions on the screen, and participants are instructed to move the cursor toward each target. Throughout the experiment, EEG signals from the motor cortex, EMG signals from four primary muscles involved in Flexion-Extension and Ulnar-Radial Deviation, and wrist joint angles from the exoskeleton's motor encoders are simultaneously recorded.<br></pre><p></p>", "funding": null, "funding_list": [], "version": 3, "status": "public", "size": 3683416050, "created_date": "2026-03-09T23:53:20Z", "modified_date": "2026-03-09T23:53:21Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["EEG (Electroencephalography)", "EMG (Electromyography)", "multimodal recordings", "wrist exoskeleton", "virtual interface", "neural biomarkers"], "keywords": ["EEG (Electroencephalography)", "EMG (Electromyography)", "multimodal recordings", "wrist exoskeleton", "virtual interface", "neural biomarkers"], "categories": [{"id": 24739, "title": "Neurology and neuromuscular diseases", "parent_id": 24724, "path": "/24457/24724/24739", "source_id": "320905", "taxonomy_id": 100}], "references": [], "has_linked_file": false, "citation": "Perez Blanco, Jorge German; Anteliz Ortiz, Javier Mauricio (2025). EEG-EMG-WristMotion Dataset. figshare. Dataset. https://doi.org/10.6084/m9.figshare.29666735.v3", "related_materials": [], "is_embargoed": false, "embargo_date": null, "embargo_type": null, "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 29666735, "title": "EEG-EMG-WristMotion Dataset", "doi": "10.6084/m9.figshare.29666735.v3", "handle": "", "url": "https://api.figshare.com/v2/articles/29666735", "published_date": "2026-03-09T23:53:20Z", "thumb": "", "defined_type": 3, "defined_type_name": "dataset", "group_id": null, "url_private_api": "https://api.figshare.com/v2/account/articles/29666735", "url_public_api": "https://api.figshare.com/v2/articles/29666735", "url_private_html": "https://figshare.com/account/articles/29666735", "url_public_html": "https://figshare.com/articles/dataset/EEG-EMG-WristMotion_Dataset/29666735", "timeline": {"posted": "2026-03-09T23:53:20", "firstOnline": "2025-07-29"}, "resource_title": null, "resource_doi": null}