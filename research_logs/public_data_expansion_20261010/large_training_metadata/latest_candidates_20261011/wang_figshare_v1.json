renbach", "is_active": true, "url_name": "Maxim_Karrenbach", "orcid_id": ""}, {"id": 18740053, "full_name": "Yidan Ding", "first_name": "Yidan", "last_name": "Ding", "is_active": true, "url_name": "Yidan_Ding", "orcid_id": "0009-0003-9363-7755"}, {"id": 6537365, "full_name": "Bin He", "first_name": "Bin", "last_name": "He", "is_active": true, "url_name": "Bin_He", "orcid_id": ""}], "custom_fields": [{"name": "Publisher Statement", "value": "", "settings": {"validations": {"min_length": 2, "max_length": 2000}, "placeholder": "Add the text and full citation to the published version."}, "field_type": "textarea", "order": null, "is_mandatory": false}, {"name": "Date", "value": "", "settings": {}, "field_type": "date", "order": null, "is_mandatory": false}], "figshare_url": "https://kilthub.cmu.edu/articles/dataset/EEG_Datasets_for_Sensory-Guided_Joint_Learning_in_Motor_Imagery_Brain-Computer_Interfaces/32293995", "download_disabled": false, "description": "<p dir=\"ltr\">This dataset contains de-identified electroencephalography (EEG) and behavioral data collected from a real-time motor imagery brain-computer interface (MI-BCI) study evaluating a sensory-guided human-machine joint learning framework. The dataset includes recordings from 31 BCI-na\u00efve participants assigned to four experimental groups: a sensory-guided joint learning group (with selective tactile stimulation and weighted EEGNet feeback), a tactile stimulation control group (with tactile stimulation and EEGNet feedback), an EEGNet control group (without tactile stimulation, only with EEGNet feedback) and a BCI2000 control group (without tactile stimulation, only with BCI2000 feedback). Data are organized by experimental group, anonymous subject ID, session, and run.<br><br>EEG was recorded from a 64-channel montage, and the released neural data include 62 EEG channels after excluding auxiliary channels such as EOG, ECG, and EMG.</p><p dir=\"ltr\"><br>The detailed description of the study can be found in the following publication: Sensory-guided human-machine joint learning accelerates the acquisition of motor imagery brain computer interface control</p><p dir=\"ltr\">Hanwen Wang, Yisha Zhang, Maxim Karrenbach, Yidan Ding, Bin He</p><p dir=\"ltr\"><br></p><p dir=\"ltr\">If you use a part of this dataset in your work, please cite the above publication.</p><p dir=\"ltr\"><br>This dataset was collected under support from the National Institutes of Health via grants NS124564 (BH), NS131069 (BH), NS127849 (BH), and NS096761 (BH).</p><p><br></p><p dir=\"ltr\">Correspondence about the dataset: Dr. Bin He, Carnegie Mellon University, Department of Biomedical Engineering, Pittsburgh, PA 15213. E-mail: bhe1@andrew.cmu.edu</p>", "funding": "NS124564", "funding_list": [{"id": 22855319, "title": "NS124564", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 25809082, "title": "NS131069", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 25809079, "title": "NS127849", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 19423967, "title": "NS096761", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 1, "status": "public", "size": 63738061009, "created_date": "2026-05-29T17:15:11Z", "modified_date": "2026-05-29T17:15:11Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 10, "name": "CC BY-NC 4.0", "url": "https://creativecommons.org/licenses/by-nc/4.0/"}, "tags": ["BCI", "brain computer interface", "machine learning", "motor imagery", "brain signal decoding"], "keywords": ["BCI", "brain computer interface", "machine learning", "motor imagery", "brain signal decoding"], "categories": [{"id": 33014, "title": "Biomedical engineering", "parent_id": 32963, "path": "/32963/33014", "source_id": "4003", "taxonomy_id": 102}, {"id": 31475, "title": "Neurosciences", "parent_id": 31208, "path": "/31208/31475", "source_i