{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"nm000250","name":"Dreyer et al. 2023 — A large EEG database with users' profile information for motor imagery brain-computer interface research","description":"A large EEG database from 87 healthy participants recorded during a single-day motor imagery brain-computer interface (BCI) experiment. The data are organized into three datasets (A, B, C) that share one Graz-protocol task, left- versus right-hand motor imagery, with 240 trials per participant (over 20,800 trials in total). It also provides demographic, personality and cognitive-trait information, which supports studies of how user profiles relate to BCI performance and cross-user classification algorithms.","source":"nemar","recording_modality":["EEG"],"bids_version":null,"license":"CC-BY-4.0","authors":[{"name":"Pauline Dreyer","name_type":"Personal","orcid":"0000-0001-6895-9638"},{"name":"Aline Roc","name_type":"Personal"},{"name":"Léa Pillette","name_type":"Personal"},{"name":"Sébastien Rimbert","name_type":"Personal"},{"name":"Fabien Lotte","name_type":"Personal"}],"anonymous":false,"keywords":[{"term":"EEG"},{"term":"motor imagery"},{"term":"brain-computer interface"},{"term":"BCI illiteracy"},{"term":"user training"},{"term":"personality profile"},{"term":"Electroencephalography","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D004569"}],"related_identifiers":[{"identifier":"10.1038/s41597-023-02445-z","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"10.5281/zenodo.8089820","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"https://github.com/nemarDatasets/nm000250","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"https://nemar.org/dataset/nm000250","identifier_type":"URL","relation_type":"IsDescribedBy"}],"data_papers":[{"doi":"10.1038/s41597-023-02445-z","title":"A large EEG database with users’ profile information for motor imagery brain-computer interface r