{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"nm000316","name":"IMUMIA2026: Multi-paradigm motor-imagery EEG dataset (IMU-MI_A)","description":"A multi-paradigm motor-imagery EEG dataset recorded from healthy participants at Inner Mongolia University. It covers five body-part tasks (hand, foot, thumb, index finger, index-thumb pinch) with left/right laterality, performed under a Classic Arrow paradigm and a Cue-Execution dual-stage paradigm. This BIDS release is a public five-subject sample of a 244-participant dataset, recorded with a 64-channel Neuroscan system at 1000 Hz.","source":"nemar","recording_modality":["EEG"],"bids_version":null,"license":"CC-BY-4.0","authors":[{"name":"Jianxiu Li","name_type":"Personal"},{"name":"Changming Wang","name_type":"Personal"},{"name":"Chao Chen","name_type":"Personal"}],"anonymous":false,"keywords":[{"term":"EEG"},{"term":"motor imagery"},{"term":"brain-computer interface"},{"term":"fine motor imagery"},{"term":"Electroencephalography","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D004569"},{"term":"Imagery, Psychotherapy","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D019018"}],"related_identifiers":[{"identifier":"10.5281/zenodo.20421767","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"https://github.com/nemarDatasets/nm000316","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"https://nemar.org/dataset/nm000316","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"10.21105/joss.01896","identifier_type":"DOI","relation_type":"References"},{"identifier":"10.1038/s41597-019-0104-8","identifier_type":"DOI","relation_type":"References"}],"contributors":[],"dates":[],"rights":[{"rights":"CC-BY-4.0","rights_uri":null,"rights_identifier":"CC-BY-4.0","rights_identifier_scheme":"SPDX"}],"language":null,"funding":[],"tasks":["imagery"],"datatypes":["eeg"],"sessions":["0"],"sessions_count":1,"demographics":{"subjects_count