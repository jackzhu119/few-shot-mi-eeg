{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"nm000327","name":"Leeuwis2021: Left- vs right-hand motor-imagery EEG dataset","description":"A single-session EEG dataset of left- versus right-hand motor imagery recorded from 55 healthy, BCI-naive participants using a 16-channel g.Nautilus system at 250 Hz. Each participant completed one calibration run without feedback and three feedback runs, for 160 trials in total. The data were collected to examine psychological and cognitive predictors of motor-imagery brain-computer interface performance. This BIDS release was converted from the original DataverseNL deposit via MOABB.","source":"nemar","recording_modality":["EEG"],"bids_version":null,"license":"CC-BY-4.0","authors":[{"name":"Nikki Leeuwis","name_type":"Personal"},{"name":"Alissa Paas","name_type":"Personal"},{"name":"Maryam Alimardani","name_type":"Personal","orcid":"0000-0003-3077-7657","affiliations":[{"name":"Tilburg University, Tilburg School of Humanities and Digital Sciences","identifier":null,"scheme":null}]}],"anonymous":false,"keywords":[{"term":"Electroencephalography","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D004569"},{"term":"Brain-Computer Interfaces","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D062207"},{"term":"motor imagery"},{"term":"EEG"},{"term":"personality"},{"term":"Cognition","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D003071"}],"related_identifiers":[{"identifier":"10.34894/Z7ZVOD","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"https://github.com/nemarDatasets/nm000327","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"https://nemar.org/dataset/nm000327","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"10.21105/joss.01896","identifier_type":"DOI","relation_type":"References"},{"identifier":"10.1038/s41597-019-0104-8","identifier_type":"DOI","relation_type":"References"},{"identifier":"10.3389