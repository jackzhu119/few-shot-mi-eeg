{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"nm000348","name":"Yang et al. 2025 — A multi-day and high-quality EEG dataset for motor imagery brain-computer interface","description":"A multi-day EEG dataset for motor imagery brain-computer interface (MI-BCI) research collected at Shanghai University (WBCIC-SHU). It contains recordings from 51 healthy, BCI-naive participants who performed left- and right-hand motor imagery over three sessions on different days. A subset of 11 participants also performed a three-class paradigm that adds foot-hooking imagery. Recordings were made with a 59-channel EEG system and the dataset is accompanied by benchmark classification results using CSP, FBCSP, EEGNet, deepConvNet and FBCNet.","source":"nemar","recording_modality":["EEG"],"bids_version":null,"license":"CC-BY-4.0","authors":[{"name":"Banghua Yang","name_type":"Personal"},{"name":"Fenqi Rong","name_type":"Personal"},{"name":"Yunlong Xie","name_type":"Personal"},{"name":"Du Li","name_type":"Personal"},{"name":"Jiayang Zhang","name_type":"Personal"},{"name":"Fu Li","name_type":"Personal"},{"name":"Guangming Shi","name_type":"Personal"},{"name":"Xiaorong Gao","name_type":"Personal"}],"anonymous":false,"keywords":[{"term":"EEG"},{"term":"motor imagery"},{"term":"Brain-Computer Interfaces","subject_scheme":"MeSH","scheme_uri":"https://id.nlm.nih.gov/mesh/","value_uri":"http://id.nlm.nih.gov/mesh/D062207"},{"term":"multi-day recording"},{"term":"BCI benchmark"},{"term":"Imagination","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D007092"}],"related_identifiers":[{"identifier":"10.1038/s41597-025-04826-y","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"https://github.com/nemarDatasets/nm000348","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"https://nemar.org/dataset/nm000348","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"10.21105/joss.01896","identifier_type":"DOI","relation_