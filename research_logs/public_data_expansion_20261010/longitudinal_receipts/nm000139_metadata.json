{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"nm000139","name":"BNCI 2014-001 Motor Imagery dataset","description":"This dataset contains EEG recordings from 9 healthy subjects performing cued motor imagery of left hand, right hand, feet, and tongue movements, known as BCI Competition IV Dataset 2a. Each subject completed two sessions of six runs, with 22 EEG and 3 EOG channels sampled at 250 Hz. It is widely used as a benchmark for multi-class motor imagery classification in brain-computer interface research.","source":"nemar","recording_modality":["EEG"],"bids_version":null,"license":"CC-BY-ND-4.0","authors":[{"name":"Michael Tangermann","name_type":"Personal"},{"name":"Klaus-Robert Müller","name_type":"Personal"},{"name":"Ad Aertsen","name_type":"Personal"},{"name":"Niels Birbaumer","name_type":"Personal"},{"name":"Christoph Braun","name_type":"Personal"},{"name":"Clemens Brunner","name_type":"Personal","orcid":"0000-0002-6030-2233"},{"name":"Robert Leeb","name_type":"Personal"},{"name":"Carsten Mehring","name_type":"Personal"},{"name":"Kai J. Miller","name_type":"Personal"},{"name":"Gernot R. Müller-Putz","name_type":"Personal"},{"name":"Guido Nolte","name_type":"Personal"},{"name":"Gert Pfurtscheller","name_type":"Personal"},{"name":"Hubert Preissl","name_type":"Personal"},{"name":"Gerwin Schalk","name_type":"Personal"},{"name":"Alois Schlögl","name_type":"Personal"},{"name":"Carmen Vidaurre","name_type":"Personal"},{"name":"Stephan Waldert","name_type":"Personal"},{"name":"Benjamin Blankertz","name_type":"Personal"}],"anonymous":false,"keywords":[{"term":"EEG"},{"term":"motor imagery"},{"term":"Brain-Computer Interfaces","subject_scheme":"MeSH","scheme_uri":"https://id.nlm.nih.gov/mesh/","value_uri":"http://id.nlm.nih.gov/mesh/D062207"},{"term":"BCI competition"},{"term":"event-related desynchronization"}],"related_identifiers":[{"identifier":"10.3389/fnins.2012.00055","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"https