{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"nm000339","name":"Stieger et al. 2021 — Continuous sensorimotor rhythm based brain computer interface learning in a large population","description":"A large, longitudinal EEG dataset collected while 62 healthy adults learned to control a sensorimotor rhythm-based brain-computer interface. Participants completed 7-11 online training sessions of continuous cursor control using motor imagery of the left hand, right hand, both hands, and rest. In total the dataset comprises 598 sessions and over 250,000 trials, offering a resource for designing and evaluating BCI algorithms and for studying BCI learning.","source":"nemar","recording_modality":["EEG"],"bids_version":null,"license":"CC-BY-NC-4.0","authors":[{"name":"James R. Stieger","name_type":"Personal"},{"name":"Stephen A. Engel","name_type":"Personal"},{"name":"Bin He","name_type":"Personal","orcid":"0000-0003-2944-8602"}],"anonymous":false,"keywords":[{"term":"Brain-Computer Interfaces","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D062207"},{"term":"Electroencephalography","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D004569"},{"term":"sensorimotor rhythm"},{"term":"motor imagery"},{"term":"longitudinal"},{"term":"BCI learning"}],"related_identifiers":[{"identifier":"10.1038/s41597-021-00883-1","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"10.6084/m9.figshare.13123148.v1","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"https://github.com/nemarDatasets/nm000339","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"10.21105/joss.01896","identifier_type":"DOI","relation_type":"References"},{"identifier":"10.1038/s41597-019-0104-8","identifier_type":"DOI","relation_type":"References"},{"identifier":"https://nemar.org/dataset/nm000339","identifier_type":"URL","relation_type":"IsDescribedBy"}],"data_papers":[{"doi":"10.1038/s41597-021-00883-1","title":"Cont