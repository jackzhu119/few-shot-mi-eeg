{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"nm000177","name":"Multi-session longitudinal motor imagery EEG dataset (Kumar et al. 2024)","description":"A longitudinal motor imagery EEG dataset from 18 BCI-naive participants recorded across six sessions (one offline, five online) with 22 EEG channels at 512 Hz. It supports the study of transfer learning for brain-computer interface skill acquisition, comparing unsupervised Generic Recentering and supervised Personally Assisted Recentering for calibration-free training. Participants performed left/right hand motor imagery with continuous visual feedback.","source":"nemar","recording_modality":["EEG"],"bids_version":null,"license":"CC-BY-4.0","authors":[{"name":"Satyam Kumar","name_type":"Personal","orcid":"0000-0003-4817-1768","affiliations":[{"name":"Chandra Family Department of Electrical and Computer Engineering, The University of Texas at Austin , Austin, TX 78712 , USA","identifier":null,"scheme":null}]},{"name":"Hussein Alawieh","name_type":"Personal","orcid":"0000-0002-2888-4958","affiliations":[{"name":"Chandra Family Department of Electrical and Computer Engineering, The University of Texas at Austin , Austin, TX 78712 , USA","identifier":null,"scheme":null}]},{"name":"Frigyes Samuel Racz","name_type":"Personal","orcid":"0000-0001-9077-498X","affiliations":[{"name":"Department of Neurology, The University of Texas at Austin , Austin, TX 78712 , USA","identifier":null,"scheme":null},{"name":"Mulva Clinic for the Neurosciences, The University of Texas at Austin , Austin, TX 78712 , USA","identifier":null,"scheme":null}]},{"name":"Rawan Fakhreddine","name_type":"Personal","orcid":"0000-0002-6012-4019","affiliations":[{"name":"Chandra Family Department of Electrical and Computer Engineering, The University of Texas at Austin , Austin, TX 78712 , USA","identifier":null,"scheme":null}]},{"name":"Jose del R. Millan","name_type":"Personal","orcid":"0000-0001-5819-1522","affiliations":[{"name":"Chandra