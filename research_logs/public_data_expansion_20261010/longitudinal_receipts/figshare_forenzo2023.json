e01e5239560fc3ba3a74d193", "mimetype": "application/zip"}, {"id": 41612949, "name": "Subject22.zip", "size": 4184378025, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/41612949", "supplied_md5": "c891ba1633c9be0bf4b11d6453268f58", "computed_md5": "c891ba1633c9be0bf4b11d6453268f58", "mimetype": "application/zip"}, {"id": 41613000, "name": "Subject23.zip", "size": 3819068893, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/41613000", "supplied_md5": "192cc350924af364a02fc499dec2d74e", "computed_md5": "192cc350924af364a02fc499dec2d74e", "mimetype": "application/zip"}, {"id": 41613033, "name": "Subject24.zip", "size": 3757268261, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/41613033", "supplied_md5": "46a64ed6ba02df769697652ff112d19c", "computed_md5": "46a64ed6ba02df769697652ff112d19c", "mimetype": "application/zip"}, {"id": 41613144, "name": "Subject25.zip", "size": 3709432684, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/41613144", "supplied_md5": "13bf3f1674ac75a3efc89d6e6fe4673a", "computed_md5": "13bf3f1674ac75a3efc89d6e6fe4673a", "mimetype": "application/zip"}, {"id": 41730165, "name": "README.txt", "size": 2766, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/41730165", "supplied_md5": "eba7aee6f2ac678f60af7101da52e275", "computed_md5": "eba7aee6f2ac678f60af7101da52e275", "mimetype": "text/plain"}], "folder_structure": {}, "authors": [{"id": 16510905, "full_name": "Dylan Forenzo", "first_name": "Dylan", "last_name": "Forenzo", "is_active": true, "url_name": "Dylan_Forenzo", "orcid_id": ""}, {"id": 6537365, "full_name": "Bin He", "first_name": "Bin", "last_name": "He", "is_active": true, "url_name": "Bin_He", "orcid_id": ""}], "custom_fields": [{"name": "Publisher Statement", "value": "", "settings": {"validations": {"min_length": 2, "max_length": 2000}, "placeholder": "Add the text and full citation to the published version."}, "field_type": "textarea", "order": null, "is_mandatory": false}, {"name": "Date", "value": "2023-07-13", "settings": {}, "field_type": "date", "order": null, "is_mandatory": false}], "figshare_url": "https://kilthub.cmu.edu/articles/dataset/EEG-BCI_Dataset_for_Motor_Imagery_and_Overt_Spatial_Attention_EEG-BCI_Control/23677098", "download_disabled": false, "description": "<p>This dataset consists of EEG recordings and Brain-Computer Interface (BCI) data from 25 different human subjects performing BCI experiments. More information can be found in the corresponding manuscript:\u00a0</p>\n<p><br></p>\n<p>Dylan Forenzo, Yixuan Liu, Jeehyun Kim, Yidan Ding, Taehyung Yoon, Bin He: \u201cIntegrating Simultaneous Motor Imagery and Spatial Attention for EEG-BCI Control\u201d, IEEE Transactions on Biomedical Engineering (<a href=\"https://doi.org/10.1109/tbme.2023.3298957\" target=\"_blank\">10.1109/TBME.2023.3298957</a>).</p>\n<p><br></p>\n<p>Please cite this paper if you use any data included in this dataset.\u00a0</p>\n<p><br></p>\n<p>The dataset was collected under the support of NIH grants AT009263, EB021027, EB029354, NS096761,</p>\n<p>NS124564 to Dr. Bin He at Carnegie Mellon University.</p>\n<p><br></p>\n<p>Each file is a MATLAB object (.mat file) which contains data from a single run of BCI control. The MATLAB files are grouped into folders based on the Subject, one for each of the 25 subjects studied. Each subject completed 5 sessions of BCI experiments and each session consisted of either 18 (sessions 1 and 2) or 15 (sessions 3-5) runs, for a total of 81 runs per subject or 2025 total BCI runs.</p>\n<p><br></p>\n<p>Each of the MATLAB files contains a single structure with the following fields:</p>\n<p><br></p>\n<p><strong>data:</strong> An array containing the EEG recordings with the size (channels x time points)</p>\n<p><br></p>\n<p><strong>times:</strong> A vector containing the timestamps in milisceonds with the size (1 x time points)</p>\n<p><br></p>\n<p><strong>fs:</strong> sampling frequency (1000 Hz)</p>\n<p><br></p>\n<p><strong>labels:</strong> A cell array containing the label for each channel</p>\n<p><br></p>\n<p><strong>targets:</strong> A list of target codes. For LR: 1 is right, 2 is left. For UD: 1 is up, 2 is down. For 2D: 1 is right, 2 is left, 3 is up, and 4 is down</p>\n<p><br></p>\n<p><strong>event: </strong>A structure of events from BCI2000. Each index corresponds to the start of a trial and includes the time (latency) of when the trial starts, and how long each trial lasted (duration).</p>\n<p><br></p>\n<p><strong>results:</strong> A vector of which target was hit for each trial (0 if the trial was aborted before a target was hit)</p>\n<p><br></p>\n<p><strong>outcome:</strong> A vector indicating the outcome of each trail (1: hit, 0: abort, -1: miss)</p>\n<p><br></p>\n<p><strong>subject:</strong> The coded subject number</p>\n<p><br></p>\n<p><strong>session:</strong> The session number. Please note that the session numbers are for specific tasks, so even though 2D sessions began on the third day of experiments, the 2D runs are listed as session 1, 2, and 3 as they are the first, second, and third 2D sessions.</p>\n<p><br></p>\n<p><strong>axis:</strong> The axis of control. Either LR (horizontal only, Left-Right), UD (vertical only, Up-Down), or 2D (both horizontal and vertical control).</p>\n<p><br></p>\n<p><strong>task:</strong> The control paradigm used. Options are MI (motor imagery), OSA (overt spatial attention), MIOSA (MI and OSA together), MIOSA1 (MI controls horizontal axis, OSA controls vertical. Referred to as MI/OSA in the paper), or MIOSA2 (MI controls vertical axis, OSA controls horizontal. Referred to as OSA/MI in the paper).</p>\n<p><br></p>\n<p><strong>run:</strong> The run number</p>", "funding": "NIH AT009263", "funding_list": [{"id": 13769744, "title": "NIH AT009263", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 22717365, "title": "NIH EB021027", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23946189, "title": "NIH EB029354", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23946192, "title": "NIH NS096761", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 23946195, "title": "NIH NS124564", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 1, "status": "public", "size": 94185903469, "created_date": "2023-08-04T19:48:44Z", "modified_date": "2023-08-04T19:48:45Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["Brain-Computer Interface", "Neural Engineering", "EEG", "Motor Imagery", "Overt Spatial Attention", "Neuroscience"], "keywords": ["Brain-Computer Interface", "Neural Engineering", "EEG", "Motor Imagery", "Overt Spatial Attention", "Neuroscience"], "categories": [{"id": 31499, "title": "Neurosciences not elsewhere classified", "parent_id": 31475, "path": "/31208/31475/31499", "source_id": "320999", "taxonomy_id": 102}], "references": ["https://doi.org/10.1109/TBME.2023.3298957"], "has_linked_file": false, "citation": "Forenzo, Dylan; He, Bin (2023). EEG-BCI Dataset for Motor Imagery and Overt Spatial Attention EEG-BCI Control. Carnegie Mellon University. Dataset. https://doi.org/10.1184/R1/23677098.v1", "related_materials": [{"id": 144079194, "identifier": "10.1109/TBME.2023.3298957", "title": "Integrating Simultaneous Motor Imagery and Spatial Attention for EEG-BCI Control", "relation": "IsSupplementTo", "identifier_type": "DOI", "is_linkout": true, "link": "https://doi.org/10.1109/TBME.2023.3298957"}], "is_embargoed": false, "embargo_date": null, "embargo_type": "file", "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 23677098, "title": "EEG-BCI Dataset for Motor Imagery and Overt Spatial Attention EEG