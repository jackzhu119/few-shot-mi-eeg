{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"nm000246","name":"Multi-day MI-BCI dataset (WBCIC-SHU) from Yang et al 2025","description":"A multi-day motor imagery brain-computer interface EEG dataset recorded from 51 healthy, BCI-naive participants over three sessions on different days. Participants performed left-hand and right-hand motor imagery (2-class, 51 subjects), and a subset of 11 subjects also performed a 3-class paradigm that added foot-hooking. Recordings used 59 EEG channels plus ECG and EOG at 1000 Hz. The data are provided in BIDS format with HED event annotations and benchmark classification results (CSP, FBCSP, EEGNet, deepConvNet, FBCNet).","source":"nemar","recording_modality":["EEG"],"bids_version":null,"license":"CC-BY-4.0","authors":[{"name":"Banghua Yang","name_type":"Personal"},{"name":"Fenqi Rong","name_type":"Personal"},{"name":"Yunlong Xie","name_type":"Personal"},{"name":"Du Li","name_type":"Personal"},{"name":"Jiayang Zhang","name_type":"Personal"},{"name":"Fu Li","name_type":"Personal"},{"name":"Guangming Shi","name_type":"Personal"},{"name":"Xiaorong Gao","name_type":"Personal"}],"anonymous":false,"keywords":[{"term":"EEG"},{"term":"motor imagery"},{"term":"Brain-Computer Interfaces","subject_scheme":"MeSH","scheme_uri":"https://id.nlm.nih.gov/mesh/","value_uri":"http://id.nlm.nih.gov/mesh/D062207"},{"term":"multi-day recording"},{"term":"left/right hand imagery"},{"term":"BCI benchmark"}],"related_identifiers":[{"identifier":"10.1038/s41597-025-04826-y","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"https://github.com/nemarDatasets/nm000246","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"10.21105/joss.01896","identifier_type":"DOI","relation_type":"References"},{"identifier":"10.1038/s41597-019-0104-8","identifier_type":"DOI","relation_type":"References"},{"identifier":"https://nemar.org/dataset/nm000246","identifier_type":"URL","relation_type":"IsDescribedBy"}],"data_p