{"schema_version":"0.4.1","doc_type":"dataset","dataset_id":"nm000140","name":"BNCI 2015-001 Motor Imagery dataset","description":"EEG recordings from 12 healthy, BCI-naive participants performing two-class motor imagery (sustained right-hand palmar grip versus both-feet plantar extension) across two sessions, with 200 trials per session. Data were recorded from 13 sensorimotor channels at 512 Hz with visual cursor feedback, in support of an autocalibrating, recurrently adapting online ERD-based brain-computer interface. The dataset is distributed in BIDS format via MOABB.","source":"nemar","recording_modality":["EEG"],"bids_version":null,"license":"CC-BY-NC-ND-4.0","authors":[{"name":"Josef Faller","name_type":"Personal"},{"name":"Carmen Vidaurre","name_type":"Personal"},{"name":"Teodoro Solis-Escalante","name_type":"Personal"},{"name":"Christa Neuper","name_type":"Personal"},{"name":"Reinhold Scherer","name_type":"Personal"}],"anonymous":false,"keywords":[{"term":"EEG"},{"term":"motor imagery"},{"term":"Brain-Computer Interfaces","subject_scheme":"MeSH","scheme_uri":"https://id.nlm.nih.gov/mesh/","value_uri":"http://id.nlm.nih.gov/mesh/D062207"},{"term":"event-related desynchronization"},{"term":"sensorimotor rhythms"},{"term":"online adaptation"}],"related_identifiers":[{"identifier":"10.1109/tnsre.2012.2189584","identifier_type":"DOI","relation_type":"IsDerivedFrom"},{"identifier":"https://github.com/nemarDatasets/nm000140","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"10.21105/joss.01896","identifier_type":"DOI","relation_type":"References"},{"identifier":"10.1038/s41597-019-0104-8","identifier_type":"DOI","relation_type":"References"},{"identifier":"https://nemar.org/dataset/nm000140","identifier_type":"URL","relation_type":"IsDescribedBy"}],"data_papers":[{"doi":"10.1109/tnsre.2012.2189584","title":"Autocalibration and Recurrent Adaptation: Towards a Plug and Play Online ERD-BCI","year":2012,"venue":"IEEE Transactions on Neural Syste